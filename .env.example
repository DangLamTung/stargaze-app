# ─── StarGaze API Keys (Example Template) ───
# Copy this file to `.env` and fill in your keys.

# WeatherAPI.com — Current conditions & 3-day forecast
# Sign up: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=your_weatherapi_key_here

# OpenWeatherMap — Current weather & map tile proxy
# Sign up: https://openweathermap.org/api
OWM_KEY=your_open-weather-map_key_here

# AccuWeather — Current conditions
# Sign up: https://developer.accuweather.com/
ACCUWEATHER_KEY=your_accuweather_key_here

# Windy.com Point Forecast API (ECMWF, GFS, ICON)
# Sign up: https://api.windy.com/
WINDY_KEY=your_windy_key_here

# Google Maps Geocoding API (Optional primary geocoder fallback)
# https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Server Port (default: 3000)
PORT=3000

