{
  "name": "stargaze",
  "version": "1.0.0",
  "private": true,
  "description": "StarGaze — Stargazing & Sightseeing Planner",
  "scripts": {
    "lint": "eslint 'src/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' --fix",
    "format": "prettier --write 'src/**/*.js' 'src/**/*.css' '*.html'",
    "format:check": "prettier --check 'src/**/*.js' 'src/**/*.css' '*.html'",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "eslint-config-prettier": "^9.1.0"
  }
}
